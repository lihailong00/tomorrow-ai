# Local defaults. scripts/Initialize-Local.ps1 creates a private .env.
DATABASE_URL=sqlite:data/tomorrow.db
API_BIND=127.0.0.1:8080
SCHEDULER_MODE=local
RUST_LOG=tomorrow_api=info,tomorrow_worker=info

# Phone authentication is disabled until explicitly configured. Production must use APP_ENV=production.
# Local fixed-code development only: APP_ENV=local, PHONE_AUTH_MODE=local_test, API_BIND=127.0.0.1:8080.
# local_test is rejected for a public bind or any APP_ENV other than local. Never use it behind a public proxy.
APP_ENV=local
PHONE_AUTH_MODE=disabled
# Real SMS: PHONE_AUTH_MODE=aliyun_pnvs uses Alibaba Cloud PNVS SendSmsVerifyCode (not Dysms).
# Activate PNVS SMS authentication in a real-name-verified account; take the complimentary sign/template from its console.
# Use a RAM credential restricted to dypns:SendSmsVerifyCode. Keep all of these on the backend only.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
# Independent random secret >=32 bytes. Changing it invalidates outstanding challenges; never log it.
SMS_CODE_HASH_KEY=
# Persistent rolling attempted-send quotas: 1/60s and 5/24h per phone across registration/password reset;
# globally 3/60s, 10/hour, and this limit per rolling 24h. Failed sends retain admission.
# Failed/unknown sends retain quota; no automatic retry or returned code. Template variables must be code and min.
SMS_DAILY_LIMIT=100
# Optional private-test allowlist, comma-separated mainland numbers (normal +86 formats accepted).
# Empty allows all numbers; invalid nonempty values disable phone auth. Keep this backend-only.
SMS_ALLOWED_PHONES=

# Start-Local.ps1 uses Pi by default and generates an ephemeral internal service token.
# Choose -AgentMode direct for the previous direct model/local execution mode.
AGENT_MODE=pi
AGENT_URL=http://127.0.0.1:8090
AGENT_PORT=8090
RUST_API_URL=http://127.0.0.1:8080
AGENT_SERVICE_TOKEN=
AGENT_MAX_TURNS=10
AGENT_MAX_TOOLS=20
AGENT_TIMEOUT_MS=100000
AGENT_MAX_CONCURRENT=4

# Optional explicit OpenAI-compatible model. These settings take priority over DeepSeek.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# DeepSeek fallback: prefer DEEPSEEK_API_KEY in the backend process environment.
# Defaults: https://api.deepseek.com and deepseek-flash. Never put these in the mobile app.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional speech transcription. Empty means unavailable, never fake text.
# Qwen: ASR_PROTOCOL=qwen_asr, ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1,
# ASR_MODEL=qwen3-asr-flash. Set ASR_API_KEY only in backend private environment.
ASR_PROTOCOL=openai_transcriptions
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
UPLOAD_DIR=data/uploads

# Temporal mode: start compose services and build worker with --features temporal.
TEMPORAL_ADDRESS=http://127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tomorrow-tasks-v1
TEMPORAL_DISPATCHER_ID=tomorrow-task-dispatcher-v1

# Private local credentials are generated by Initialize-Local.ps1.
POSTGRES_PASSWORD=
CONNECTOR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/connectors/google/callback

# Optional S3 driver (build API with --features s3). Local RustFS profile is for testing.
UPLOAD_STORAGE=local
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=tomorrow-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
