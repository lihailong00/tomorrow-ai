# Local defaults. scripts/Initialize-Local.ps1 creates a private .env.
DATABASE_URL=sqlite:data/tomorrow.db
API_BIND=127.0.0.1:8080
SCHEDULER_MODE=local
RUST_LOG=tomorrow_api=info,tomorrow_worker=info

# Phone authentication is disabled until explicitly configured. Production must use APP_ENV=production.
# Local fixed-code development only: APP_ENV=local, PHONE_AUTH_MODE=local_test, API_BIND=127.0.0.1:8080.
# local_test is rejected for a public bind or any APP_ENV other than local. Never use it behind a public proxy.
APP_ENV=local
PHONE_AUTH_MODE=disabled
# Real SMS: PHONE_AUTH_MODE=aliyun_pnvs uses Alibaba Cloud PNVS SendSmsVerifyCode (not Dysms).
# Activate PNVS SMS authentication in a real-name-verified account; take the complimentary sign/template from its console.
# Use a RAM credential restricted to dypns:SendSmsVerifyCode. Keep all of these on the backend only.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
# Independent random secret >=32 bytes. Changing it invalidates outstanding challenges; never log it.
SMS_CODE_HASH_KEY=
# Persistent rolling attempted-send quotas: 1/60s and 5/24h per phone across registration/password reset;
# globally 3/60s, 10/hour, and this limit per rolling 24h. Failed sends retain admission.
# Failed/unknown sends retain quota; no automatic retry or returned code. Template variables must be code and min.
SMS_DAILY_LIMIT=100
# Optional private-test allowlist, comma-separated mainland numbers (normal +86 formats accepted).
# Empty allows all numbers; invalid nonempty values disable phone auth. Keep this backend-only.
SMS_ALLOWED_PHONES=

# Start-Local.ps1 uses Pi by default and generates an ephemeral internal service token.
# Choose -AgentMode direct for the previous direct model/local execution mode.
# Choose -AgentMode dsh to run DeepSeek Harness; -AgentMode pi switches back.
# Set the same AGENT_MODE on Rust API/worker and Node. A failed run is never auto-replayed in Pi.
AGENT_MODE=pi
AGENT_URL=http://127.0.0.1:8090
AGENT_PORT=8090
RUST_API_URL=http://127.0.0.1:8080
AGENT_SERVICE_TOKEN=
AGENT_MAX_TURNS=256
AGENT_MAX_TOOLS=240
AGENT_TIMEOUT_MS=1200000
AGENT_MAX_CONCURRENT=4
AGENT_MAX_WEB_SEARCHES=100
AGENT_MAX_WEB_FETCHES=100
# Optional AKTools MCP endpoint for public market data. Keep it on the backend network.
AKSHARE_MCP_URL=
AKSHARE_MCP_TOKEN=

# Optional explicit OpenAI-compatible model. These settings take priority over DeepSeek.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# DeepSeek fallback: prefer DEEPSEEK_API_KEY in the backend process environment.
# Defaults: https://api.deepseek.com and deepseek-flash. Never put these in the mobile app.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Optional speech transcription. Empty means unavailable, never fake text.
# Qwen: ASR_PROTOCOL=qwen_asr, ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1,
# ASR_MODEL=qwen3-asr-flash. Set ASR_API_KEY only in backend private environment.
ASR_PROTOCOL=openai_transcriptions
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
UPLOAD_DIR=data/uploads

# Optional text-only semantic search for explicitly opted-in photo indices.
# Keys stay in the backend; an existing official Qwen ASR key can be reused.
PHOTO_EMBEDDING_ENABLED=true
PHOTO_EMBEDDING_BASE_URL=
PHOTO_EMBEDDING_API_KEY=
PHOTO_EMBEDDING_MODEL=text-embedding-v4

# Temporal mode: start compose services and build worker with --features temporal.
TEMPORAL_ADDRESS=http://127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tomorrow-tasks-v1
TEMPORAL_DISPATCHER_ID=tomorrow-task-dispatcher-v1

# Private local credentials are generated by Initialize-Local.ps1.
POSTGRES_PASSWORD=
CONNECTOR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/connectors/google/callback

# Chinese apps: phone notification/share imports require no provider API key.
# Optional cloud sync below is configured by the app operator, not ordinary users.
# CONNECTOR_ENCRYPTION_KEY above must be a random 32-byte key encoded as 64 hex chars.
# User mail authorization codes and personal tokens are stored encrypted server-side.
# Each user's Amap Web service Key is configured in the app and stored encrypted.
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=
TENCENT_DOCS_REDIRECT_URI=
TENCENT_DOCS_SCOPES=scope.drive.readonly
WPS_CLIENT_ID=
WPS_CLIENT_SECRET=
WPS_REDIRECT_URI=
WPS_SCOPES=kso.file.read
FEISHU_CLIENT_ID=
FEISHU_CLIENT_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_SCOPES=drive:drive.metadata:readonly offline_access
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=
DINGTALK_SCOPES=openid
# Slack internal app: user scope search:read.public, no bot or write scopes.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# HTTPS callbacks: /v1/integrations/{tencent_docs|wps|feishu|dingtalk|slack}/callback
# Each resource API additionally requires console-approved permissions + user consent.

# Optional wearable health services. Endpoints/scopes are built in; app operators
# must obtain provider approval, then users grant their own read permissions.
# Blank callbacks derive from INSTANCE_PUBLIC_URL (HTTPS origin only).
# Register /v1/health/oauth/{huawei|xiaomi}/callback with the matching provider.
HUAWEI_HEALTH_CLIENT_ID=
HUAWEI_HEALTH_CLIENT_SECRET=
HUAWEI_HEALTH_REDIRECT_URI=
XIAOMI_HEALTH_CLIENT_ID=
XIAOMI_HEALTH_CLIENT_SECRET=
XIAOMI_HEALTH_REDIRECT_URI=

# Optional S3 driver (build API with --features s3). Local RustFS profile is for testing.
UPLOAD_STORAGE=local
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=tomorrow-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Cloud photo analysis: temporary image copies in request memory only.
# Reuses an existing official Qwen ASR credential if the explicit base is empty.
# A separate, explicit per-device cloud_processing consent is always required.
PHOTO_VISION_ENABLED=true
PHOTO_VISION_BASE_URL=
PHOTO_VISION_API_KEY=
# Current cloud deployment: verified with synthetic image OCR/description/labels.
PHOTO_VISION_MODEL=qwen3.7-flash

# Optional default Memos address shown in each user's connection form.
# Personal Memos/Notion/Yuque tokens belong to the per-user encrypted vault.
MEMOS_DEFAULT_SERVER_URL=
# Exact origins only, comma separated. Needed for an intentionally private
# self-hosted instance, e.g. http://memos:5230. Public instances require HTTPS.
MEMOS_ALLOWED_PRIVATE_ORIGINS=
