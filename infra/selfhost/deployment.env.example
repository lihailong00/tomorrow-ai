# Optional nonsecret deployment values. Never commit real credentials.
TADA_VERSION=local
# Loopback default: place a HTTPS reverse proxy on the same host.
TADA_BIND=127.0.0.1
TADA_PORT=8080
# Leave empty to configure in the webpage. Nonempty values lock the UI field.
INSTANCE_MODE=
INSTANCE_NAME=
INSTANCE_PUBLIC_URL=
REGISTRATION_POLICY=
