# API-only private environment file: /etc/tomorrow/asr.env, root:root 0600.
# Beijing workspace key; never put this key in runtime.env or the APK.
ASR_PROTOCOL=qwen_asr
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash
ASR_API_KEY=
# Rolling 24-hour attempted-call limits, editable in the administration page.
# Positive integers 1..1000000 only; zero does not disable safeguards.
# Failed/ambiguous provider calls still count; cached transcripts cost no attempt.
ASR_USER_DAILY_LIMIT=1000
ASR_GLOBAL_DAILY_LIMIT=5000
# These are counts, not a currency budget. Audio remains bounded at 7 MiB.
# Two calls may run per API process, with a bounded 15-second admission wait.
