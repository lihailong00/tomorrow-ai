API_BIND=127.0.0.1:8080
APP_ENV=production
PHONE_AUTH_MODE=disabled
SCHEDULER_MODE=local
AGENT_MODE=pi
AGENT_URL=http://127.0.0.1:8090
AGENT_PORT=8090
RUST_API_URL=http://127.0.0.1:8080
TADA_RUNTIME_CONFIG=enabled
TADA_CONFIG_DIR=/var/lib/tomorrow/config
TADA_ADMIN_DIST=/opt/tomorrow/admin
AGENT_MODEL_NAME=deepseek-flash
AGENT_SERVICE_TOKEN=GENERATE_A_RANDOM_64_HEX_TOKEN
AGENT_MAX_WEB_SEARCHES=100
AGENT_MAX_WEB_FETCHES=100
AGENT_MAX_TURNS=256
AGENT_MAX_TOOLS=240
AGENT_TIMEOUT_MS=1200000
AGENT_MAX_CONCURRENT=4
UPLOAD_STORAGE=local
UPLOAD_DIR=/var/lib/tomorrow/uploads
UPLOAD_MAX_BYTES=26214400
RUST_LOG=tomorrow_api=info,tomorrow_worker=info,tower_http=info
